# LeadTriage Environment Configuration
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional anon key for future frontend/client flows. The backend does not use it.
SUPABASE_KEY=

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_SECONDS=20

# Application Configuration
ENVIRONMENT=development
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
REQUEST_MAX_BYTES=32768

# API Configuration
API_TITLE=LeadTriage API
API_VERSION=0.1.0
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
# Required in production for /health/queue. Generate like JWT_SECRET.
QUEUE_METRICS_TOKEN=

# Outbound CRM Configuration
# Both values are required before CRM sync is enabled.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_TIMEOUT_SECONDS=5
CRM_RETRY_BASE_SECONDS=60
CRM_RETRY_MAX_SECONDS=3600
CRM_RETRY_MAX_ATTEMPTS=5
CRM_RETRY_CLAIM_TIMEOUT_SECONDS=300
CRM_RETRY_BATCH_SIZE=10
CRM_RETRY_POLL_SECONDS=30

# Worker Alert Routing
# Configure both values to deliver signed alerts; otherwise incidents are logged only.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_STALLED_QUEUE_ITERATIONS=3
ALERT_HIGH_ERROR_RATE_THRESHOLD=0.5
ALERT_MIN_ERROR_SAMPLE_SIZE=5
ALERT_REPEATED_CRASH_COUNT=3
ALERT_COOLDOWN_SECONDS=900

# Deduplication Settings
DEDUP_WINDOW_DAYS=7
# Reserved for future classified-field deduplication. Milestone 3A uses
# normalized source, normalized message, and DEDUP_WINDOW_DAYS.
DEDUP_STRATEGY=email  # email, phone, or both

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
